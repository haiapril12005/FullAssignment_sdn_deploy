# Copy this file to .env (local) - on Render set the same keys in "Environment"
PORT=3000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/SimpleQuiz
# MongoDB Atlas (deploy):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SimpleQuiz?retryWrites=true&w=majority
AUTH_SECRET=change-me-to-a-long-random-string
